{{!
    @template local_berufsbildung/kompetenzraster_marken

    Die HK eines Bereichs als Badges mit ihrem Kuerzel, Pflicht zuerst,
    Wahlpflicht dahinter mit Beschriftung. Fuer die Klappen auf schmalen
    Bildschirmen und die zugeklappte Uebersicht in den Kacheln von
    meine_lernenden.php - ein Bereich passt so in eine Zeile. Der Stand
    steht ausser in der Farbe als Titel und fuer Screenreader als Text da.

    Context variables required for this template:
    * hatwahlpflicht - bool
    * zellen - array of {istleer, istwahlpflicht, istvollstaendig, marke, markenklasse, titel, statustext}

    Example context (json):
    {
        "hatwahlpflicht": true,
        "zellen": [
            {"istleer": false, "istwahlpflicht": false, "istvollstaendig": true, "marke": "a.01",
             "markenklasse": "bg-success text-white", "titel": "a.01 · Pflicht · vollständig vorgekommen",
             "statustext": "vollständig vorgekommen"},
            {"istleer": false, "istwahlpflicht": false, "istvollstaendig": false, "marke": "a.02",
             "markenklasse": "bg-white text-info border border-info", "titel": "a.02 · Pflicht · später eingeplant",
             "statustext": "später eingeplant"},
            {"istleer": false, "istwahlpflicht": true, "istvollstaendig": false, "marke": "a.04",
             "markenklasse": "text-muted border", "titel": "a.04 · Wahlpflicht · noch nicht geplant",
             "statustext": "noch nicht geplant"},
            {"istleer": true}
        ]
    }
}}
<span class="local-berufsbildung-raster-marken">
    {{#zellen}}
        {{^istleer}}
            {{^istwahlpflicht}}
                <span class="badge local-berufsbildung-raster-marke {{markenklasse}}" title="{{titel}}">{{#istvollstaendig}}<i class="icon fa fa-check fa-fw m-0" aria-hidden="true"></i>{{/istvollstaendig}}{{marke}}<span class="local-berufsbildung-nurtext"> {{statustext}}</span></span>
            {{/istwahlpflicht}}
        {{/istleer}}
    {{/zellen}}
    {{#hatwahlpflicht}}
        <span class="local-berufsbildung-raster-markenart small text-muted">{{#str}} raster:wahlpflicht, local_berufsbildung {{/str}}</span>
        {{#zellen}}
            {{#istwahlpflicht}}
                <span class="badge local-berufsbildung-raster-marke {{markenklasse}}" title="{{titel}}">{{#istvollstaendig}}<i class="icon fa fa-check fa-fw m-0" aria-hidden="true"></i>{{/istvollstaendig}}{{marke}}<span class="local-berufsbildung-nurtext"> {{statustext}}</span></span>
            {{/istwahlpflicht}}
        {{/zellen}}
    {{/hatwahlpflicht}}
</span>
