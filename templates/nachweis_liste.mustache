{{!
    @template local_berufsbildung/nachweis_liste

    Nachweise gruppiert, neueste zuerst je Gruppe. Die Gruppe ist je nach
    Aufruf die Quelle oder das Semester - im zweiten Fall weist jede Zeile
    zusaetzlich ihre Quelle aus (hasquelle).

    Context variables required for this template:
    * gruppen - array of {name, nachweise: [{bezeichnung, datum, hasergebnis, ergebnis, hasurl, url, hasquelle, quelle}]}
    * hasgruppen - bool
    * hastitel - bool
    * titel - string, Ueberschrift ueber der ganzen Liste
    * leertext - string, wenn keine Nachweise vorhanden sind

    Example context (json):
    {
        "hasgruppen": true,
        "hastitel": true,
        "titel": "Tätigkeiten",
        "leertext": "Keine Tätigkeiten vorhanden.",
        "gruppen": [
            {
                "name": "3. Semester",
                "nachweise": [
                    {
                        "bezeichnung": "üK 3: Steuerungstechnik",
                        "datum": "14. März 2026",
                        "hasergebnis": true,
                        "ergebnis": "5.0",
                        "hasurl": false,
                        "url": "",
                        "hasquelle": true,
                        "quelle": "Überbetriebliche Kurse"
                    }
                ]
            }
        ]
    }
}}
<div class="local-berufsbildung-nachweise">
    {{#hastitel}}
        <h3 class="h5 mb-2">{{titel}}</h3>
    {{/hastitel}}
    {{#hasgruppen}}
        {{#gruppen}}
            <div class="local-berufsbildung-nachweisgruppe mb-3">
                <h4 class="local-berufsbildung-quellenname h6 text-uppercase text-muted mb-2">{{name}}</h4>
                <ul class="list-unstyled mb-0">
                    {{#nachweise}}
                        <li class="local-berufsbildung-nachweis d-flex justify-content-between align-items-baseline py-1 border-bottom">
                            <span class="local-berufsbildung-nachweis-titel">
                                {{#hasurl}}<a href="{{url}}">{{/hasurl}}{{bezeichnung}}{{#hasurl}}</a> <i class="icon fa fa-external-link-alt fa-fw" aria-hidden="true"></i>{{/hasurl}}
                                {{#hasergebnis}}<span class="badge bg-secondary ml-2">{{ergebnis}}</span>{{/hasergebnis}}
                                {{#hasquelle}}<span class="local-berufsbildung-nachweis-quelle badge bg-light text-dark border ml-2">{{quelle}}</span>{{/hasquelle}}
                            </span>
                            <span class="local-berufsbildung-nachweis-datum text-muted small text-nowrap ml-2">{{datum}}</span>
                        </li>
                    {{/nachweise}}
                </ul>
            </div>
        {{/gruppen}}
    {{/hasgruppen}}
    {{^hasgruppen}}
        <p class="text-muted mb-0">{{leertext}}</p>
    {{/hasgruppen}}
</div>
