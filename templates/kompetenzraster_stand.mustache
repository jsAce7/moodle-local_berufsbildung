{{!
    @template local_berufsbildung/kompetenzraster_stand

    Der Stand des Kompetenzrasters in Worten: Pflicht-HK, die noch in
    keinem Einsatz vorkommen, Wahlpflicht je Gruppe von Bereichen, ein
    Hinweis, wenn nichts im Plan vorkommt, und bis wann der Plan reicht.
    Im Raster ueber der Tabelle; zugeklappt klein unter der Uebersicht,
    dort ohne den Satz zur Zusammenfassung - den traegt die Zahl neben
    dem Titel - und ohne die HK ohne Einsatz, die zeigen die Badges.

    Context variables required for this template: siehe
    local_berufsbildung/kompetenzraster.

    Example context (json):
    {
        "zugeklappt": false,
        "haszusammenfassung": true,
        "zusammenfassung": "1 von 2 Pflicht-Handlungskompetenzen kamen schon in Einsätzen vor, bei 1 davon alle Leistungskriterien.",
        "hatohneeinsatz": true,
        "ohneeinsatzwarnung": false,
        "ohneeinsatz": "Noch nicht geplant: a.02",
        "wahlpflichtwege": [
            {"hattitel": false, "staende": [
                {"text": "Wahlpflicht aus a, b, c: 1 verlangt · 1 begonnen, 0 eingeplant",
                 "erfuellt": false, "eingerueckt": false}
            ]}
        ],
        "hathorizont": true,
        "horizont": "Vorliegender Versetzungsplan reicht bis 20. August 2027."
    }
}}
{{^zugeklappt}}{{#haszusammenfassung}}
    <p class="local-berufsbildung-raster-zusammenfassung mb-1">{{zusammenfassung}}</p>
{{/haszusammenfassung}}{{/zugeklappt}}
{{^zugeklappt}}{{#hatohneeinsatz}}
    {{! Vor dem letzten Lehrjahr ist das der Normalfall und steht ruhig da;
        reicht der Plan bis zum Lehrende, ist es eine Luecke. Zugeklappt
        zeigen es die grauen, dann gelben Badges der Uebersicht. }}
    <p class="local-berufsbildung-raster-zusammenfassung mb-1{{#ohneeinsatzwarnung}} text-danger{{/ohneeinsatzwarnung}}{{^ohneeinsatzwarnung}} text-muted{{/ohneeinsatzwarnung}}">
        {{#ohneeinsatzwarnung}}<i class="icon fa fa-exclamation-triangle fa-fw" aria-hidden="true"></i>{{/ohneeinsatzwarnung}}{{ohneeinsatz}}
    </p>
{{/hatohneeinsatz}}{{/zugeklappt}}
{{#hatwahlpflichtwahl}}
    <p class="local-berufsbildung-raster-zusammenfassung mb-1">{{wahlpflichtwahl}}</p>
{{/hatwahlpflichtwahl}}
{{#wahlpflichtwege}}
    {{#hattitel}}
        <p class="local-berufsbildung-raster-zusammenfassung mb-1">
            {{titel}}
            {{#erfuellt}}
                <span class="badge bg-success text-white">{{#pix}}i/checked, core{{/pix}}{{#str}} raster:wahlpflicht_erfuellt, local_berufsbildung {{/str}}</span>
            {{/erfuellt}}
        </p>
    {{/hattitel}}
    {{#staende}}
        <p class="local-berufsbildung-raster-zusammenfassung mb-1{{#eingerueckt}} local-berufsbildung-raster-wahlpflicht-eingerueckt{{/eingerueckt}}">
            {{text}}
            {{#erfuellt}}
                <span class="badge bg-success text-white">{{#pix}}i/checked, core{{/pix}}{{#str}} raster:wahlpflicht_erfuellt, local_berufsbildung {{/str}}</span>
            {{/erfuellt}}
        </p>
    {{/staende}}
{{/wahlpflichtwege}}
{{#hathinweis}}
    <div class="alert alert-info py-2 mb-2" role="status">
        {{hinweis}}
        {{#hatbloeckelink}}<a href="{{bloeckeurl}}">{{bloeckelinktext}}</a>{{/hatbloeckelink}}
    </div>
{{/hathinweis}}
{{#hathorizont}}
    <p class="{{^zugeklappt}}small {{/zugeklappt}}text-muted mb-2">{{horizont}}</p>
{{/hathorizont}}
