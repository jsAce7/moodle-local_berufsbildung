{{!
    @template local_berufsbildung/stationen_leiste

    Die Stationen einer Quelle (etwa die Bildungsberichte) zuoberst im
    Detail einer Person auf "Meine Lernenden" und auf "Meine Lehre": eine
    Zeitleiste ueber die ganze Lehre, darunter die aktuelle Station mit
    ihrem Stand und der Aktion. Erledigte Stationen zeigen ihren Stand
    (etwa das Gespraechsdatum) und den Link in der Zeitleiste selbst.

    Die Zeitleiste ist eine geordnete Liste; der Punkt je Station ist
    Schmuck (aria-hidden), Name und Statustext tragen die Bedeutung. Eine
    Linie fuehrt von der aktuellen Station hinunter in ihren Kasten, beide
    in der Randfarbe ihres Punkts, damit man sieht, wozu er gehoert. Der
    Kasten steht in denselben Spalten wie die Leiste, ueber die Haelfte
    davon und mittig unter seinem Punkt (stationen_leiste::kasten_spalten()),
    und rollt mit ihr; auf schmalen Bildschirmen nimmt er die ganze Breite.
    Auf schmalen Fenstern rollt die Leiste waagrecht in ihrem Kasten, statt
    die Seite zu verbreitern. Den Abstand nach aussen setzt die Seite: auf
    "Meine Lehre" steht die Leiste in einer eigenen Karte.

    Context variables required for this template:
    * titel - string, Anzeigename der Quelle
    * anzahl - int, Zahl der Stationen und damit der Spalten
    * kastenstart - int, erste Spalte des Kastens der aktuellen Station, ab 1
    * kastenbreite - int, Zahl der Spalten des Kastens
    * hasverlauf - bool
    * verlaufurl - string
    * eintraege - array of {bezeichnung, kurzbezeichnung, statustext, zeigestatus, status, hasstand, stand, zeigestand,
      hasurl, url, aktuell, hasicon, icon, punktklasse, randklasse, istueberfaellig}; zeigestatus false haelt einen
      Statustext, der nur "geplant" sagt, unsichtbar (output\stationen_leiste::zeige_status())
    * hasaktuelle - bool
    * aktuelle - wie ein Eintrag in eintraege
    * hasaktion - bool
    * aktion - {label, url, klasse}, klasse btn-primary oder btn-outline-primary

    Example context (json):
    {
        "titel": "Bildungsbericht",
        "anzahl": 3,
        "kastenstart": 1,
        "kastenbreite": 2,
        "hasverlauf": true,
        "verlaufurl": "/local/bildungsbericht/verlauf.php?userid=5",
        "eintraege": [
            {"bezeichnung": "Bildungsbericht 1. Semester", "kurzbezeichnung": "1. Semester", "statustext": "freigegeben", "zeigestatus": true, "status": "erledigt",
             "hasstand": true, "stand": "Gespräch am 2. Februar 2026", "zeigestand": true, "hasurl": true,
             "url": "/local/bildungsbericht/ansicht.php?id=1", "aktuell": false, "hasicon": true,
             "icon": "fa-check", "punktklasse": "bg-success text-white border-success", "randklasse": "border-success", "istueberfaellig": false},
            {"bezeichnung": "Bildungsbericht 2. Semester", "kurzbezeichnung": "2. Semester", "statustext": "in Arbeit", "zeigestatus": true, "status": "offen",
             "hasstand": true, "stand": "Fällig bis 31. August 2026 · in Arbeit, 14 von 22 Angaben erfasst",
             "zeigestand": false, "hasurl": true, "url": "/local/bildungsbericht/erfassen.php?id=2", "aktuell": true,
             "hasicon": true, "icon": "fa-edit", "punktklasse": "bg-primary text-white border-primary",
             "randklasse": "border-primary", "istueberfaellig": false},
            {"bezeichnung": "Bildungsbericht 3. Semester", "kurzbezeichnung": "3. Semester", "statustext": "geplant", "zeigestatus": false, "status": "geplant",
             "hasstand": true, "stand": "Fällig bis 28. Februar 2027", "zeigestand": false, "hasurl": false, "url": "",
             "aktuell": false, "hasicon": false, "icon": "", "punktklasse": "bg-white border",
             "randklasse": "", "istueberfaellig": false}
        ],
        "hasaktuelle": true,
        "aktuelle": {"bezeichnung": "Bildungsbericht 2. Semester", "kurzbezeichnung": "2. Semester", "statustext": "in Arbeit", "status": "offen",
            "hasstand": true, "stand": "Fällig bis 31. August 2026 · in Arbeit, 14 von 22 Angaben erfasst",
            "hasurl": true, "url": "/local/bildungsbericht/erfassen.php?id=2", "aktuell": true,
            "hasicon": true, "icon": "fa-edit", "punktklasse": "bg-primary text-white border-primary",
            "randklasse": "border-primary", "istueberfaellig": false},
        "hasaktion": true,
        "aktion": {"label": "Bildungsbericht 2. Semester weiter erfassen", "url": "/local/bildungsbericht/erfassen.php?id=2", "klasse": "btn-primary"}
    }
}}
<section class="local-berufsbildung-stationen" aria-labelledby="{{uniqid}}-stationen-titel">
    <div class="local-berufsbildung-stationen-kopf mb-2">
        <h3 class="h5 mb-0" id="{{uniqid}}-stationen-titel">{{titel}}</h3>
        {{#hasverlauf}}
            <a href="{{verlaufurl}}" class="small">{{#str}} stationen:verlauf, local_berufsbildung {{/str}}</a>
        {{/hasverlauf}}
    </div>
    <div class="local-berufsbildung-stationen-rollbar">
        <ol class="local-berufsbildung-stationen-leiste list-unstyled mb-0">
            {{#eintraege}}
                <li class="local-berufsbildung-station"{{#aktuell}} aria-current="step"{{/aktuell}}>
                    <span class="local-berufsbildung-station-linie border-top" aria-hidden="true"></span>
                    <span class="local-berufsbildung-station-punkt border {{punktklasse}}{{#aktuell}} local-berufsbildung-station-punkt-aktuell{{/aktuell}}" aria-hidden="true">
                        {{#hasicon}}<i class="icon fa {{icon}} fa-fw m-0"></i>{{/hasicon}}
                    </span>
                    <span class="local-berufsbildung-station-name{{#aktuell}} font-weight-bold fw-bold{{/aktuell}}">
                        {{#hasurl}}<a href="{{url}}">{{kurzbezeichnung}}</a>{{/hasurl}}
                        {{^hasurl}}{{kurzbezeichnung}}{{/hasurl}}
                    </span>
                    {{#zeigestatus}}<span class="d-block small {{#istueberfaellig}}text-danger{{/istueberfaellig}}{{^istueberfaellig}}text-muted{{/istueberfaellig}}">{{statustext}}</span>{{/zeigestatus}}
                    {{^zeigestatus}}<span class="sr-only visually-hidden">{{statustext}}</span>{{/zeigestatus}}
                    {{#zeigestand}}<span class="d-block small text-muted">{{stand}}</span>{{/zeigestand}}
                    {{#aktuell}}<span class="local-berufsbildung-station-verbinder border-left border-start {{randklasse}}" aria-hidden="true"></span>{{/aktuell}}
                </li>
            {{/eintraege}}
        </ol>
        {{#hasaktuelle}}
            {{#aktuelle}}
                <div class="local-berufsbildung-stationen-aktuell-spalten" style="grid-template-columns: repeat({{anzahl}}, minmax(6.5rem, 1fr));">
                    <div class="local-berufsbildung-stationen-aktuell bg-light border {{randklasse}} rounded" style="grid-column: {{kastenstart}} / span {{kastenbreite}};">
                        <div class="local-berufsbildung-stationen-aktuell-text">
                            <strong class="d-block">{{bezeichnung}} · <span class="{{#istueberfaellig}}text-danger{{/istueberfaellig}}">{{statustext}}</span></strong>
                            {{#hasstand}}<span class="d-block small text-muted">{{stand}}</span>{{/hasstand}}
                        </div>
                        {{#hasaktion}}
                            {{#aktion}}
                                <a href="{{url}}" class="btn {{klasse}}">{{label}}</a>
                            {{/aktion}}
                        {{/hasaktion}}
                    </div>
                </div>
            {{/aktuelle}}
        {{/hasaktuelle}}
    </div>
    {{^hasaktuelle}}
        {{#hasaktion}}
            {{#aktion}}
                <div class="mt-3"><a href="{{url}}" class="btn {{klasse}}">{{label}}</a></div>
            {{/aktion}}
        {{/hasaktion}}
    {{/hasaktuelle}}
</section>
