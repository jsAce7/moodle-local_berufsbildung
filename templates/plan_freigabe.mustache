{{!
    @template local_berufsbildung/plan_freigabe

    Eine zurueckgehaltene Versetzungsplan-Lieferung auf plan_freigabe.php:
    Eckdaten, die Aenderungen je gelieferter Person, wer nicht mehr
    geliefert wird, das Protokoll und die Knoepfe Freigeben und Verwerfen.
    Beide fuehren zuerst auf eine Bestaetigung.

    Context variables required for this template:
    * id - int, ID der wartenden Lieferung
    * url - string, Adresse der Seite
    * titel - string, etwa "Lieferung vom 3. November 2026"
    * quelle, ausgefuehrtvon - string
    * zeilengelesen, personenheute, einsaetzeheute - int
    * personenvorher - string, "-" ohne letzten erfolgreichen Import
    * anzahlaenderungen - int
    * haspersonenunveraendert - bool
    * personenunveraendert - int
    * personen - array of {name, einsaetze}, alphabetisch
      * einsaetze - array of {entfaellt, block, zeitraum}; entfaellt false heisst neu
    * hasfehlende - bool
    * anzahlfehlende - int
    * fehlende - array of {name}
    * hasprotokoll - bool
    * protokoll - array of {zeile}

    Example context (json):
    {
        "id": 12,
        "url": "/local/berufsbildung/plan_freigabe.php",
        "titel": "Lieferung vom Dienstag, 3. November 2026, 06:00",
        "quelle": "webservice",
        "ausgefuehrtvon": "Dienstkonto Versetzungsplan",
        "zeilengelesen": 1,
        "personenvorher": "5",
        "personenheute": 1,
        "einsaetzeheute": 1,
        "anzahlaenderungen": 1,
        "haspersonenunveraendert": false,
        "personenunveraendert": 0,
        "personen": [
            {"name": "Anna Muster", "einsaetze": [
                {"entfaellt": true, "block": "4", "zeitraum": "2027-W15 – 2027-W16"},
                {"entfaellt": false, "block": "4", "zeitraum": "2027-W20 – 2027-W21"}
            ]}
        ],
        "hasfehlende": true,
        "anzahlfehlende": 1,
        "fehlende": [{"name": "Ben Beispiel"}],
        "hasprotokoll": true,
        "protokoll": [{"zeile": "Zeile 3: unbekannte Mailadresse alt.name@firma.ch"}]
    }
}}
<section class="local-berufsbildung-planfreigabe mb-4">
    <h3>{{titel}}</h3>
    <table class="generaltable">
        <tbody>
            <tr><th scope="row">{{#str}} planfreigabe:quelle, local_berufsbildung {{/str}}</th><td>{{quelle}}</td></tr>
            <tr><th scope="row">{{#str}} planfreigabe:ausgefuehrt_von, local_berufsbildung {{/str}}</th><td>{{ausgefuehrtvon}}</td></tr>
            <tr><th scope="row">{{#str}} planimport:zeilen_gelesen, local_berufsbildung {{/str}}</th><td>{{zeilengelesen}}</td></tr>
            <tr><th scope="row">{{#str}} planfreigabe:personen_vorher, local_berufsbildung {{/str}}</th><td>{{personenvorher}}</td></tr>
            <tr><th scope="row">{{#str}} planfreigabe:personen_heute, local_berufsbildung {{/str}}</th><td>{{personenheute}}</td></tr>
            <tr><th scope="row">{{#str}} planfreigabe:einsaetze_heute, local_berufsbildung {{/str}}</th><td>{{einsaetzeheute}}</td></tr>
        </tbody>
    </table>

    <h4>{{#str}} planfreigabe:aenderungen, local_berufsbildung, {{anzahlaenderungen}} {{/str}}</h4>
    {{#haspersonenunveraendert}}
        <p>{{#str}} planfreigabe:personen_unveraendert, local_berufsbildung, {{personenunveraendert}} {{/str}}</p>
    {{/haspersonenunveraendert}}
    {{#personen}}
        <h5>{{name}}</h5>
        <table class="generaltable">
            <thead>
                <tr>
                    <th scope="col">
                        <span class="sr-only visually-hidden">{{#str}} planimport:status, local_berufsbildung {{/str}}</span>
                    </th>
                    <th scope="col">{{#str}} planfreigabe:block, local_berufsbildung {{/str}}</th>
                    <th scope="col">{{#str}} planfreigabe:zeitraum, local_berufsbildung {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#einsaetze}}
                    <tr>
                        <td>
                            {{#entfaellt}}
                                <span class="badge bg-danger">{{#str}} planfreigabe:entfaellt, local_berufsbildung {{/str}}</span>
                            {{/entfaellt}}
                            {{^entfaellt}}
                                <span class="badge bg-success">{{#str}} planfreigabe:neu, local_berufsbildung {{/str}}</span>
                            {{/entfaellt}}
                        </td>
                        <td>{{block}}</td>
                        <td>{{zeitraum}}</td>
                    </tr>
                {{/einsaetze}}
            </tbody>
        </table>
    {{/personen}}

    {{#hasfehlende}}
        <h4>{{#str}} planfreigabe:fehlende_personen, local_berufsbildung, {{anzahlfehlende}} {{/str}}</h4>
        <p>{{#str}} planfreigabe:fehlende_personen_hinweis, local_berufsbildung {{/str}}</p>
        <ul>
            {{#fehlende}}<li>{{name}}</li>{{/fehlende}}
        </ul>
    {{/hasfehlende}}

    {{#hasprotokoll}}
        <h4>{{#str}} planimport:protokoll, local_berufsbildung {{/str}}</h4>
        <ul>
            {{#protokoll}}<li>{{zeile}}</li>{{/protokoll}}
        </ul>
    {{/hasprotokoll}}

    <div class="d-flex">
        <form method="get" action="{{url}}" class="mr-2 me-2">
            <input type="hidden" name="aktion" value="freigeben">
            <input type="hidden" name="id" value="{{id}}">
            <button type="submit" class="btn btn-secondary">{{#str}} planfreigabe:freigeben, local_berufsbildung {{/str}}</button>
        </form>
        <form method="get" action="{{url}}">
            <input type="hidden" name="aktion" value="verwerfen">
            <input type="hidden" name="id" value="{{id}}">
            <button type="submit" class="btn btn-secondary">{{#str}} planfreigabe:verwerfen, local_berufsbildung {{/str}}</button>
        </form>
    </div>
</section>
