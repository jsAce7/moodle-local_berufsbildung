{{!
    @template local_berufsbildung/kompetenz_auswahl

    Auswahl der Kompetenzen eines Ausbildungsblocks entlang der Gliederung
    des Bildungsplans: Handlungskompetenzbereich, darunter die
    Handlungskompetenzen, darunter deren Leistungskriterien.

    Auswaehlbar sind beide Ebenen - die Handlungskompetenz als Ganzes oder
    einzelne Leistungskriterien. Bereits zugeordnete Eintraege tragen statt
    der Checkbox einen Hinweis; entfernt werden sie in der Tabelle darueber.

    Aufgeklappt startet, wo noch etwas offen ist. Kein JavaScript: das
    native <details>-Element genuegt.

    Context variables required for this template:
    * action - string, Ziel des Formulars
    * sesskey - string
    * blockid - int
    * bereiche - array of {code, name, offen, handlungskompetenzen}
    * handlungskompetenzen - array of {id, code, hatcode, name, istzugeordnet, offen, hatlk, leistungskriterien}
    * leistungskriterien - array of {id, code, hatcode, name, istzugeordnet}
    * intensitaeten - array of {wert, text, gewaehlt}
    * intensitaetlabel - string
    * intensitaethilfe - string
    * absenden - string, Beschriftung des Buttons
    * zugeordnettext - string, Hinweis bei bereits zugeordneten Eintraegen

    Example context (json):
    {
        "action": "/local/berufsbildung/block_kompetenzen.php",
        "sesskey": "abc123",
        "blockid": 7,
        "intensitaetlabel": "Intensität",
        "intensitaethilfe": "Gilt für alle jetzt ausgewählten Kompetenzen.",
        "absenden": "Kompetenzen hinzufügen",
        "zugeordnettext": "zugeordnet",
        "intensitaeten": [
            {"wert": "schwerpunkt", "text": "Schwerpunkt", "gewaehlt": true},
            {"wert": "teilweise", "text": "teilweise", "gewaehlt": false}
        ],
        "bereiche": [
            {
                "code": "b",
                "name": "Erstellen und Inbetriebnehmen von automatisierten Anlagen",
                "offen": true,
                "handlungskompetenzen": [
                    {
                        "id": 42,
                        "code": "b.07",
                        "hatcode": true,
                        "name": "automatisierte Anlagen mit Robotern ergänzen und diese in Betrieb nehmen",
                        "istzugeordnet": false,
                        "offen": true,
                        "hatlk": true,
                        "leistungskriterien": [
                            {"id": 43, "code": "", "hatcode": false, "name": "AU b1 01 1-2", "istzugeordnet": false},
                            {"id": 44, "code": "", "hatcode": false, "name": "AU b8 01 1-2", "istzugeordnet": true}
                        ]
                    }
                ]
            }
        ]
    }
}}
<form method="post" action="{{action}}" class="local-berufsbildung-auswahl">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="id" value="{{blockid}}">
    <input type="hidden" name="speichern" value="1">

    {{#bereiche}}
        <details class="local-berufsbildung-auswahl-bereich card mb-2" {{#offen}}open{{/offen}}>
            <summary class="local-berufsbildung-auswahl-bereichkopf card-header">
                <span class="local-berufsbildung-auswahl-code badge bg-light text-dark border">{{code}}</span>
                <span class="local-berufsbildung-auswahl-bereichname">{{name}}</span>
            </summary>
            <div class="card-body py-2">
                {{#handlungskompetenzen}}
                    <details class="local-berufsbildung-auswahl-hk" {{#offen}}open{{/offen}}>
                        <summary class="local-berufsbildung-auswahl-hkkopf">
                            {{#hatcode}}
                                <span class="local-berufsbildung-auswahl-code badge bg-light text-dark border">{{code}}</span>
                            {{/hatcode}}
                            <span class="local-berufsbildung-auswahl-hkname">{{name}}</span>
                        </summary>
                        <div class="local-berufsbildung-auswahl-eintraege">
                            {{! Die Handlungskompetenz selbst, fuer Bloecke, die sie als Ganzes abdecken. }}
                            <div class="local-berufsbildung-auswahl-eintrag local-berufsbildung-auswahl-ganze-hk">
                                {{#istzugeordnet}}
                                    <span class="badge bg-light text-dark border">{{zugeordnettext}}</span>
                                    <span>{{#str}} blocklk:ganze_hk, local_berufsbildung {{/str}}</span>
                                {{/istzugeordnet}}
                                {{^istzugeordnet}}
                                    <input class="form-check-input" type="checkbox" name="competencyids[]"
                                           value="{{id}}" id="lbk-{{id}}">
                                    <label class="form-check-label" for="lbk-{{id}}">
                                        {{#str}} blocklk:ganze_hk, local_berufsbildung {{/str}}
                                    </label>
                                {{/istzugeordnet}}
                            </div>
                            {{#leistungskriterien}}
                                <div class="local-berufsbildung-auswahl-eintrag">
                                    {{#istzugeordnet}}
                                        <span class="badge bg-light text-dark border">{{zugeordnettext}}</span>
                                        <span>{{name}}</span>
                                    {{/istzugeordnet}}
                                    {{^istzugeordnet}}
                                        <input class="form-check-input" type="checkbox" name="competencyids[]"
                                               value="{{id}}" id="lbk-{{id}}">
                                        <label class="form-check-label" for="lbk-{{id}}">{{name}}</label>
                                    {{/istzugeordnet}}
                                </div>
                            {{/leistungskriterien}}
                            {{^hatlk}}
                                <p class="small text-muted mb-0">{{#str}} blocklk:keine_lk, local_berufsbildung {{/str}}</p>
                            {{/hatlk}}
                        </div>
                    </details>
                {{/handlungskompetenzen}}
            </div>
        </details>
    {{/bereiche}}

    <div class="local-berufsbildung-auswahl-fuss">
        <label class="mb-0" for="lbk-intensitaet">{{intensitaetlabel}}</label>
        <select class="custom-select form-select" name="intensitaet" id="lbk-intensitaet">
            {{#intensitaeten}}
                <option value="{{wert}}" {{#gewaehlt}}selected{{/gewaehlt}}>{{text}}</option>
            {{/intensitaeten}}
        </select>
        <button type="submit" class="btn btn-primary">{{absenden}}</button>
    </div>
    <p class="small text-muted mt-1 mb-0">{{intensitaethilfe}}</p>
</form>
