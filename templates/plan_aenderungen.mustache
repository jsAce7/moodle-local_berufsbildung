{{!
    @template local_berufsbildung/plan_aenderungen

    Je Person die Einsaetze, die ein Versetzungsplan-Import wegnimmt oder
    neu anlegt. Eigenstaendig (output\plan_aenderungen::render()) und als
    Teil von plan_freigabe.

    Context variables required for this template:
    * personen - array of {name, einsaetze}, alphabetisch
      * einsaetze - array of {entfaellt, block, zeitraum}; entfaellt false heisst neu

    Example context (json):
    {
        "personen": [
            {"name": "Anna Muster", "einsaetze": [
                {"entfaellt": true, "block": "4", "zeitraum": "2027-W15 – 2027-W16"},
                {"entfaellt": false, "block": "4", "zeitraum": "2027-W20 – 2027-W21"}
            ]}
        ]
    }
}}
{{#personen}}
    <h5>{{name}}</h5>
    <table class="generaltable">
        <thead>
            <tr>
                <th scope="col">
                    <span class="sr-only visually-hidden">{{#str}} planimport:status, local_berufsbildung {{/str}}</span>
                </th>
                <th scope="col">{{#str}} planfreigabe:block, local_berufsbildung {{/str}}</th>
                <th scope="col">{{#str}} planfreigabe:zeitraum, local_berufsbildung {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#einsaetze}}
                <tr>
                    <td>
                        {{#entfaellt}}
                            <span class="badge bg-danger">{{#str}} planfreigabe:entfaellt, local_berufsbildung {{/str}}</span>
                        {{/entfaellt}}
                        {{^entfaellt}}
                            <span class="badge bg-success">{{#str}} planfreigabe:neu, local_berufsbildung {{/str}}</span>
                        {{/entfaellt}}
                    </td>
                    <td>{{block}}</td>
                    <td>{{zeitraum}}</td>
                </tr>
            {{/einsaetze}}
        </tbody>
    </table>
{{/personen}}
